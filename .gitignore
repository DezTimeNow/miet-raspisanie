# Сборки Android
build/
.gradle/
*.apk
*.aab
*.ap_
*.dex

# Локальное
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Кэши и ключи
teacher-index.json
/tmp-cache/
*.log

# Отладочные снимки экрана и дампы UI — служебные файлы, в репозитории
# не требуются. Исключение: скриншоты для README лежат в docs/.
*.png
!docs/*.png
# Иконка приложения — тоже PNG, и она обязана быть в репозитории: без неё
# сборка из чистого клона остаётся без значка. Правило выше срабатывало и
# на ней, поэтому исключение идёт после него.
!app/src/main/res/mipmap-*/ic_launcher*.png
device_cache.xml
device_prefs.xml
screen*.xml
ui.xml

# Скрипты сборки и снятия снимков для локального стенда: содержат пути к
# SDK и параметры конкретной машины, переносимость в другие окружения
# не гарантирована
run.sh
shot.sh

# Служебное кэширование Kotlin-компилятора: машина за машиной разное,
# в истории только мусор.
.kotlin/
